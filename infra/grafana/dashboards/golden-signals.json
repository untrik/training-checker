{
  "uid": "training-golden-signals",
  "title": "Training Checker — Golden Signals",
  "schemaVersion": 41,
  "version": 1,
  "tags": [
    "training",
    "lab07"
  ],
  "timezone": "browser",
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Запрос аналитики: RPS, окно 1 минута",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "training:analytics_requests:rate1m",
          "legendFormat": "training-rest",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Доля 5xx аналитики, окно 1 минута",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "training:analytics_error_ratio:rate1m",
          "legendFormat": "5xx / подходящие запросы",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "p95 успешных аналитики, окно 1 минута",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"training-rest\",method=\"GET\",uri=\"/api/workouts/{id}/analytics\",status=\"200\"}[1m])))",
          "legendFormat": "p95",
          "range": true,
          "exemplar": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Занятость JVM heap",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (jvm_memory_used_bytes{area=\"heap\"}) / sum by (job) (jvm_memory_max_bytes{area=\"heap\"} > 0)",
          "legendFormat": "{{job}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "title": "Прикладные результаты аналитики",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(training_analytics_requests_total{job=\"training-rest\"}[1m]))",
          "legendFormat": "{{result}}",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Выполняющиеся расчёты аналитики",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "training_analytics_active{job=\"training-rest\"}",
          "legendFormat": "{{job}}",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "title": "Ответ 200 не дольше 500 мс, окно 5 минут",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "training:analytics_good_ratio:rate5m",
          "legendFormat": "SLI за 5 минут",
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "title": "Доступность scrape targets",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"gateway-service|training-rest|grpc-training-analytics-server\"}",
          "legendFormat": "{{job}}",
          "range": true
        }
      ]
    },
    {
      "id": 9,
      "title": "Действия при сигнале",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 8
      },
      "options": {
        "mode": "markdown",
        "content": "### Runbook: запрос аналитики тренировки\n\nСигнал: более 20% 5xx за минуту, минимум 10 подходящих запросов, выдержка 20 секунд.\n\n1. Проверьте [targets](http://localhost:19090/targets), [правила](http://localhost:19090/rules), [Alertmanager](http://localhost:9093), RPS и p95 успешных ответов.\n2. Сравните GET /api/workouts/{id}/analytics в training-rest и GET /internal/analytics в analytics. Откройте трассу через exemplar, найдите ошибочный/медленный span и JSON-логи по traceId/requestId.\n3. Для своего эксперимента проверьте режим: scripts/set-diagnostic-mode.ps1 -Mode NORMAL. Диагностический endpoint существует только под профилем observability-demo, режим истекает по TTL до 120 секунд.\n4. При реальном сбое проверьте analytics, БД/пул соединений, HTTP timeout и служебную OAuth2-аутентификацию. Устраните подтверждённую причину.\n5. Продолжайте запросы после восстановления: нужны свежие 200, нормальные длительности и снятие алерта после выхода ошибок из окна.\n\nSLI измеряется на HTTP-сервере training-rest: GET /api/workouts/{id}/analytics, подходящие 2xx/5xx, хорошие 200 не дольше 500 мс. SLO: 99,5% за скользящие 7 суток; бюджет 0,5% запросов. Панель показывает только 5 минут. Отсутствие трафика не означает 100% качества. Внешние уведомления отключены."
      }
    },
    {
      "id": 10,
      "title": "Ошибки аналитики в структурных логах",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 8
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"training-apps\",service=\"training-rest\"} | json | outcome=\"failure\""
        }
      ]
    },
    {
      "id": 11,
      "title": "Пул БД: занятые / максимум",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(hikaricp_connections_active{job=\"training-rest\"}) / sum(hikaricp_connections_max{job=\"training-rest\"})",
          "range": true,
          "legendFormat": "training-rest"
        }
      ]
    },
    {
      "id": 12,
      "title": "Пул БД: ожидание соединения",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 45,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(hikaricp_connections_pending{job=\"training-rest\"})",
          "range": true,
          "legendFormat": "training-rest"
        }
      ]
    }
  ]
}
